{
  "name": "@kanitsu/desktop",
  "private": true,
  "version": "0.1.0",
  "productName": "Kanitsu",
  "main": "dist/main.js",
  "build": {
    "appId": "com.kanitsu.viewer",
    "icon": "../../assets/kanitsu-icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web/dist"
      },
      {
        "from": "../../assets/kanitsu-icon.png",
        "to": "kanitsu-icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../../assets/kanitsu-icon.ico"
    },
    "portable": {
      "artifactName": "Kanitsu-Portable-${version}-${arch}.${ext}"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "pack": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "image-size": "^2.0.2",
    "omggif": "^1.0.10",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/omggif": "^1.0.5",
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  }
}

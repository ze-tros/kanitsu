{
  "name": "@kanitu/desktop",
  "private": true,
  "version": "0.1.0",
  "main": "dist/main.js",
  "build": {
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web/dist"
      }
    ]
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "pack": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "image-size": "^2.0.2",
    "omggif": "^1.0.10",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/omggif": "^1.0.5",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}

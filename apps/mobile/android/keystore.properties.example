# 复制为 keystore.properties 并填入真实值；keystore.properties 与 *.jks 均已 gitignore。
# storeFile 相对 android/ 目录解析。生成 keystore：
#   keytool -genkeypair -v -keystore kanitsu-release.jks -alias kanitsu \
#     -keyalg RSA -keysize 4096 -validity 10000
storeFile=kanitsu-release.jks
storePassword=CHANGE_ME
keyAlias=kanitsu
keyPassword=CHANGE_ME

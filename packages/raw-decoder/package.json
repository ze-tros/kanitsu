{
  "name": "@kanitsu/raw-decoder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Camera RAW format support: extension whitelist + libraw-wasm based preview extraction and full decode.",
  "main": "src/index.ts",
  "scripts": {
    "test": "npm run test:build && node .test-build/rawDecoder.test.mjs",
    "test:build": "esbuild test/rawDecoder.test.ts --bundle --platform=node --format=esm --outfile=.test-build/rawDecoder.test.mjs --external:libraw-wasm"
  },
  "dependencies": {
    "libraw-wasm": "^1.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}

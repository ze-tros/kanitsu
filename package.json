{
  "name": "kanitu",
  "private": true,
  "version": "0.1.0",
  "description": "Kanitu Viewer - local-first cross-platform image viewer",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @kanitu/web",
    "dev:desktop": "npm run dev -w @kanitu/desktop",
    "build:web": "npm run build -w @kanitu/web",
    "build:desktop": "npm run build -w @kanitu/desktop",
    "build:portable": "node apps/desktop/scripts/build-portable.mjs",
    "verify:portable": "node apps/desktop/scripts/verify-portable.mjs",
    "release:portable": "npm run typecheck && npm test --workspaces --if-present && npm run build:portable",
    "build:mobile": "npm run build:web && npm run cap:sync -w @kanitu/mobile",
    "cap:add:android": "npm run cap:add -w @kanitu/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
